<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Grammar Checker - English</title>
  <style>
    body{font-family:Inter, system-ui, Arial; max-width:900px;margin:28px auto;padding:12px}
    h1{font-size:20px;margin:0 0 8px}
    textarea{width:100%;height:180px;padding:10px;font-size:14px}
    button{padding:8px 12px;margin:8px 4px;cursor:pointer}
    .row{display:flex;gap:8px;align-items:center;margin:8px 0}
    .result{border:1px solid #ddd;padding:10px;margin-top:12px;border-radius:8px}
    .match{padding:8px;border-bottom:1px solid #eee}
    .match:last-child{border-bottom:0}
    .suggest{display:inline-block;padding:3px 6px;margin:4px;background:#f2f2f2;border-radius:4px}
    .apply{background:#0b74de;color:white;border:none;padding:6px 8px;border-radius:6px}
    .small{font-size:13px;color:#555}
    label{font-size:14px}
    .note{font-size:12px;color:#666}
  </style>
</head>
<body>
  <h1>Grammar Checker - English</h1>
  <div class="note">Perpaduan pengecek lokal dan LanguageTool API. Buka file ini di browser untuk pakai.</div>

  <div class="row">
    <label for="lang">Bahasa</label>
    <select id="lang">
      <option value="en-US">English (US)</option>
      <option value="en-GB">English (UK)</option>
    </select>
    <label class="small">Engine</label>
    <select id="engine">
      <option value="hybrid">Hybrid (local + remote)</option>
      <option value="languagetool">LanguageTool (online)</option>
      <option value="local">Local rules only</option>
    </select>
  </div>

  <textarea id="input" placeholder="Paste or type English text here...">I has a apple. Its a good idea to check your grammar. Your going to like it.</textarea>

  <div class="row">
    <button id="check">Check Grammar</button>
    <button id="clear">Clear Highlights</button>
    <div class="small">Status: <span id="status">idle</span></div>
  </div>

  <div id="results" class="result" hidden>
    <div id="summary" class="small"></div>
    <div id="matches"></div>
  </div>

  <script>
    // Simple grammar helper plus LanguageTool integration.
    // Works fully in browser. LanguageTool needs internet access.

    const input = document.getElementById('input');
    const checkBtn = document.getElementById('check');
    const clearBtn = document.getElementById('clear');
    const resultsBox = document.getElementById('results');
    const matchesDiv = document.getElementById('matches');
    const summary = document.getElementById('summary');
    const statusSpan = document.getElementById('status');

    // Local rule-based checks. Keep rules small and deterministic.
    function localRuleCheck(text){
      const issues = [];

      // simple pattern pairs for common confusions
      const confusions = [
        {pattern: /\b(your)\b/ig, note: "check 'your' vs 'you're'"},
        {pattern: /\b(youre|you\'re)\b/ig, note: "check 'you're' form"},
        {pattern: /\b(its)\b/ig, note: "check 'its' vs 'it's'"},
        {pattern: /\b(it\'s)\b/ig, note: "check 'it's' contraction"},
        {pattern: /\b(their)\b/ig, note: "check 'their' vs 'there' vs 'they're'"},
        {pattern: /\b(there)\b/ig, note: "check 'there' vs 'their' vs 'they're'"},
        {pattern: /\b(theyre|they\'re)\b/ig, note: "check 'they're' contraction"},
      ];

      confusions.forEach(rule => {
        let m;
        while((m = rule.pattern.exec(text))){
          issues.push({offset: m.index, length: m[0].length, message: rule.note, replacements: []});
        }
      });

      // very small grammar patterns
      // 'I has' -> should be 'I have' or 'He has'
      const hasPattern = /\bI has\b/g;
      let h;
      while((h = hasPattern.exec(text))){
        issues.push({offset: h.index, length: h[0].length, message: "subject-verb agreement: 'I has' -> 'I have'", replacements:['I have']});
      }

      // 'a' before vowel sound naive check
      const aAnPattern = /\b(a)\s+([aeiouAEIOU])/g;
      let v;
      while((v = aAnPattern.exec(text))){
        const suggestion = "an " + v[2];
        issues.push({offset: v.index, length: 1, message: "Use 'an' before vowel sound", replacements:['an']});
      }

      // return unique by offset
      issues.sort((a,b)=>a.offset-b.offset);
      return issues;
    }

    // Use LanguageTool public API. No key required for casual use.
    async function checkWithLanguageTool(text, language){
      const url = 'https://api.languagetool.org/v2/check';
      const params = new URLSearchParams();
      params.append('text', text);
      params.append('language', language);

      const resp = await fetch(url, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: params.toString()
      });

      if(!resp.ok) throw new Error('LanguageTool error ' + resp.status);

      const data = await resp.json();
      // map matches to simple structure
      return data.matches.map(m=>({offset: m.offset, length: m.length, message: m.message, replacements: (m.replacements||[]).map(r=>r.value)}));
    }

    function showResults(issues){
      resultsBox.hidden = false;
      matchesDiv.innerHTML = '';
      summary.textContent = issues.length + ' issue(s) found';

      issues.forEach((it, idx)=>{
        const div = document.createElement('div');
        div.className = 'match';

        const excerpt = input.value.substr(it.offset, it.length);
        const textSpan = document.createElement('div');
        textSpan.innerHTML = '<strong>Found</strong>: "' + escapeHtml(excerpt) + '" at ' + it.offset;

        const msg = document.createElement('div');
        msg.className = 'small';
        msg.textContent = it.message;

        div.appendChild(textSpan);
        div.appendChild(msg);

        const replWrap = document.createElement('div');
        if(it.replacements && it.replacements.length){
          it.replacements.slice(0,5).forEach(rep=>{
            const b = document.createElement('button');
            b.className = 'suggest';
            b.textContent = rep;
            b.onclick = ()=>applyReplacement(it.offset, it.length, rep);
            replWrap.appendChild(b);
          });
        } else {
          const none = document.createElement('span');
          none.className = 'small';
          none.textContent = 'No suggestion';
          replWrap.appendChild(none);
        }

        div.appendChild(replWrap);
        matchesDiv.appendChild(div);
      });
    }

    function applyReplacement(offset, length, replacement){
      const text = input.value;
      const before = text.slice(0, offset);
      const after = text.slice(offset + length);
      input.value = before + replacement + after;
      // re-run check so offsets update
      runCheck();
    }

    function escapeHtml(s){
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    async function runCheck(){
      const text = input.value;
      const engine = document.getElementById('engine').value;
      const lang = document.getElementById('lang').value;

      statusSpan.textContent = 'checking';
      matchesDiv.innerHTML = '';

      let issues = [];
      try{
        if(engine === 'local'){
          issues = localRuleCheck(text);
        } else if(engine === 'languagetool'){
          const lt = await checkWithLanguageTool(text, lang);
          issues = lt;
        } else {
          // hybrid: local + lt
          const local = localRuleCheck(text);
          let lt = [];
          try{ lt = await checkWithLanguageTool(text, lang); } catch(e){
            // if network fails, still show local
            statusSpan.textContent = 'LanguageTool failed, showing local only';
          }
          // merge by offset to avoid duplicates
          const merged = [...local];
          lt.forEach(l=>{
            // skip if same offset and message exists
            if(!merged.some(m=>m.offset===l.offset && m.length===l.length)) merged.push(l);
          });
          issues = merged.sort((a,b)=>a.offset-b.offset);
        }

        if(issues.length === 0){
          resultsBox.hidden = false;
          summary.textContent = 'No issues found';
          matchesDiv.innerHTML = '<div class="small">Text looks good to this checker</div>';
        } else {
          showResults(issues);
        }
      } catch(err){
        resultsBox.hidden = false;
        summary.textContent = 'Error: ' + err.message;
        matchesDiv.innerHTML = '';
      } finally{
        statusSpan.textContent = 'idle';
      }
    }

    checkBtn.addEventListener('click', ()=>runCheck());
    clearBtn.addEventListener('click', ()=>{resultsBox.hidden = true; matchesDiv.innerHTML = ''; summary.textContent=''; statusSpan.textContent='idle'});

    // run quick check on load
    window.addEventListener('load', ()=>{/* no auto run */});
  </script>
</body>
</html>
